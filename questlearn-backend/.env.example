# Local development configuration for QuestLearn.
# Copy to .env in this directory (it is gitignored) and fill in your own values.
# Spring Boot reads it through spring.config.import in application.properties.

DB_URL=jdbc:postgresql://localhost:5432/questlearn
DB_USERNAME=postgres
DB_PASSWORD=your-local-postgres-password

DB_HOST=localhost
DB_PORT=5432
SERVER_PORT=8080

# Any >= 32 character string locally. Production must set its own.
JWT_SECRET=local-dev-secret-change-me-0123456789abcdef
JWT_EXPIRATION_MS=86400000

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave empty to disable instructor self-signup; set a shared code to allow it.
INSTRUCTOR_INVITE_CODE=

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Groq (voice viva + AI course authoring) -------------------------------
# Create a key at https://console.groq.com/keys and paste it here. Leave it
# empty and the rest of the app still works; the AI features answer 503.
GROQ_API_KEY=
GROQ_REASONING_MODEL=openai/gpt-oss-120b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
AI_HOURLY_LIMIT=30
