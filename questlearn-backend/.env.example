# Local development configuration for QuestLearn.
# Copy to .env in this directory (it is gitignored) and fill in your own values.
# Spring Boot reads it through spring.config.import in application.properties.

DB_URL=jdbc:postgresql://localhost:5432/questlearn
DB_USERNAME=postgres
DB_PASSWORD=your-local-postgres-password

DB_HOST=localhost
DB_PORT=5432
# The Vite dev server reads this to locate the API, so it must match the backend.
# QuestLearn runs on 8091; 8080 belongs to another project on this machine.
SERVER_PORT=8091

# Any >= 32 character string locally. Production must set its own.
JWT_SECRET=local-dev-secret-change-me-0123456789abcdef
JWT_EXPIRATION_MS=86400000

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave empty to disable instructor self-signup; set a shared code to allow it.
INSTRUCTOR_INVITE_CODE=

# Password for the five seeded demo accounts. Leave it empty and a brand-new
# database gets a random one printed once in the startup log; an existing
# database keeps whatever it already has. Set it to choose the value yourself,
# and set it on any machine the internet can reach.
DEMO_PASSWORD=

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Groq (voice viva + AI course authoring) -------------------------------
# Create a key at https://console.groq.com/keys and paste it here. Leave it
# empty and the rest of the app still works; the AI features answer 503.
GROQ_API_KEY=
GROQ_REASONING_MODEL=openai/gpt-oss-120b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
AI_HOURLY_LIMIT=30

# --- VerityAI course materials ---------------------------------------------
# Uploaded course PDFs are processed by the separate VerityAI service. Leave
# VERITY_ENABLED unset and the rest of QuestLearn works; the materials panel
# answers 503 until a service account is configured.
#
# Create the account once in VerityAI, then put the same credentials here. The
# account is never used by a browser, and VerityAI allows one live session per
# account, so run one QuestLearn backend against it.
VERITY_ENABLED=false
VERITY_BASE_URL=http://localhost:8080/api/v1
VERITY_SERVICE_EMAIL=
VERITY_SERVICE_PASSWORD=
VERITY_MAX_FILE_BYTES=26214400
VERITY_MAX_MATERIALS_PER_COURSE=20
VERITY_CONNECT_TIMEOUT_MS=5000
VERITY_READ_TIMEOUT_MS=120000

