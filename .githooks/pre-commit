#!/bin/sh
# Blocks a commit that would add an environment file, private key material or a
# key-shaped string. The rules live in scripts/secret-scan.sh so this hook and
# CI run exactly the same check.
#
# One-time setup per clone (the path is repository-local, not global):
#   git config core.hooksPath .githooks
#
# Bypass a single commit with: git commit --no-verify

root=$(git rev-parse --show-toplevel) || exit 1
exec sh "$root/scripts/secret-scan.sh" --staged
