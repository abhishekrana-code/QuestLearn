# QuestLearn backend environment (production).
# Install as /opt/questlearn/backend/app.env with mode 600, owned by questlearn.
# Never commit the filled-in file.

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
LOG_FILE=/opt/questlearn/backend/logs/questlearn.log

# --- PostgreSQL --------------------------------------------------------------
# Create the role/database once, and give the app its own least-privilege user.
DB_URL=jdbc:postgresql://localhost:5432/questlearn
DB_USERNAME=questlearn
DB_PASSWORD=replace-with-a-long-random-password

# --- Security ----------------------------------------------------------------
# >= 32 random bytes. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-openssl-rand-base64-48
JWT_EXPIRATION_MS=86400000

# Exact browser origins, comma separated, no trailing slash.
CORS_ORIGINS=https://questlearn.example.com

# Required for instructor self-signup. Leave empty to disable instructor signup
# entirely and create instructor accounts from the admin panel instead.
INSTRUCTOR_INVITE_CODE=replace-with-a-shared-code

# Institution code students must enter to register. At least 10 random characters.
# Production refuses student sign-up if this stays empty. Rotate by changing it and
# restarting; already-created accounts keep working.
STUDENT_INVITE_CODE=

# --- Login throttling --------------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Transactional email (recovery + address confirmation) --------------------
# The public browser origin the emailed links should point at.
APP_BASE_URL=https://questlearn.example.com
MAIL_FROM=no-reply@questlearn.example.com

# Password recovery links expire after this many minutes; one address may ask
# for this many in a rolling hour.
RESET_TOKEN_MINUTES=30
RESET_MAX_PER_HOUR=3

# Address-confirmation links expire after this many hours; one account may ask
# for this many resends in a rolling hour.
VERIFICATION_TOKEN_HOURS=48
VERIFICATION_MAX_PER_HOUR=3

# auto (default) uses Resend when RESEND_API_KEY is set, SMTP when MAIL_HOST is
# set, and otherwise writes links to the log. Force one with resend|smtp|log.
EMAIL_PROVIDER=auto

# Option A: Resend's HTTP API. No extra dependency; the key stays server-side.
RESEND_API_KEY=
RESEND_BASE_URL=https://api.resend.com

# Option B: SMTP. Leave MAIL_HOST empty when using Resend, and vice versa.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Deadline reminders ------------------------------------------------------
# Off by default: the daily digest is an explicit operational choice. When on,
# each learner gets at most one email per day for nodes that are due soon or
# overdue. A learner can opt out per account from the dashboard.
NOTIFICATIONS_ENABLED=false
# UTC cron. The default is 07:00 UTC; set this to the school's morning.
NOTIFICATIONS_CRON=0 0 7 * * *
# A deadline is "due soon" inside this many days, on every screen and in the digest.
NOTIFICATIONS_DUE_SOON_DAYS=7
# How long the sent-reminder ledger is kept (long enough to survive a moved term).
NOTIFICATIONS_RETENTION_DAYS=120

# --- Lesson video storage ---------------------------------------------------
# disk keeps files under MEDIA_VIDEO_DIR and needs no account; s3 uses any
# S3-compatible bucket (AWS S3, Cloudflare R2, MinIO). Selecting s3 without the
# bucket and key pair stops startup with a message naming what is missing.
MEDIA_STORAGE=disk
MEDIA_VIDEO_DIR=./uploads/videos
MEDIA_MAX_VIDEO_BYTES=104857600
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=auto
MEDIA_S3_ENDPOINT=
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=
MEDIA_S3_PATH_STYLE=false
# How long an upload ticket stays valid, and how long a playback redirect lives.
MEDIA_UPLOAD_TTL_MINUTES=15
MEDIA_PLAYBACK_TTL_MINUTES=60
